
class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None



def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    elif data > root.data:
        root.right = insert(root.right, data)

    return root


def search(root, key):
    if root is None:
        return False

    if root.data == key:
        return True
    elif key < root.data:
        return search(root.left, key)
    else:
        return search(root.right, key)


def inorder(root):
    if root is not None:
        inorder(root.left)
        print(root.data, end=" ")
        inorder(root.right)



def preorder(root):
    if root is not None:
        print(root.data, end=" ")
        preorder(root.left)
        preorder(root.right)



def postorder(root):
    if root is not None:
        postorder(root.left)
        postorder(root.right)
        print(root.data, end=" ")


def find_min(root):
    if root is None:
        return None

    while root.left is not None:
        root = root.left

    return root.data



def find_max(root):
    if root is None:
        return None

    while root.right is not None:
        root = root.right

    return root.data



def delete(root, key):
    if root is None:
        return None

    if key < root.data:
        root.left = delete(root.left, key)

    elif key > root.data:
        root.right = delete(root.right, key)

    else:
        
        if root.left is None and root.right is None:
            return None

        # Case 2: Only right child
        elif root.left is None:
            return root.right

        # Case 2: Only left child
        elif root.right is None:
            return root.left

        # Case 3: Two children
        temp = root.right

        while temp.left is not None:
            temp = temp.left

        root.data = temp.data
        root.right = delete(root.right, temp.data)

    return root


# 9. Count total nodes
def count_nodes(root):
    if root is None:
        return 0

    return 1 + count_nodes(root.left) + count_nodes(root.right)


# 10. Height of BST
def height(root):
    if root is None:
        return 0

    return 1 + max(height(root.left), height(root.right))


# 11. Menu-driven program
root = None

while True:
    print("\n\n--- BST OPERATIONS ---")
    print("1. Insert")
    print("2. Search")
    print("3. Inorder")
    print("4. Preorder")
    print("5. Postorder")
    print("6. Delete")
    print("7. Minimum")
    print("8. Maximum")
    print("9. Count Nodes")
    print("10. Height")
    print("11. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        data = int(input("Enter value: "))
        root = insert(root, data)

    elif choice == 2:
        key = int(input("Enter value to search: "))
        if search(root, key):
            print("Element found")
        else:
            print("Element not found")

    elif choice == 3:
        inorder(root)
        print()

    elif choice == 4:
        preorder(root)
        print()

    elif choice == 5:
        postorder(root)
        print()

    elif choice == 6:
        key = int(input("Enter value to delete: "))
        if search(root, key):
            root = delete(root, key)
            print("Element deleted")
        else:
            print("Element not found")

    elif choice == 7:
        print("Minimum:", find_min(root))

    elif choice == 8:
        print("Maximum:", find_max(root))

    elif choice == 9:
        print("Total nodes:", count_nodes(root))

    elif choice == 10:
        print("Height:", height(root))

    elif choice == 11:
        print("Program ended")
        break

    else:
        print("Invalid choice")
