
size = 7
table = [[] for i in range(size)]

def insert(key):
    index = key % size
    table[index].append(key)

def search(key):
    index = key % size
    if key in table[index]:
        print("Element found")
    else:
        print("Element not found")

def delete(key):
    index = key % size
    if key in table[index]:
        table[index].remove(key)
        print("Deleted")
    else:
        print("Element not found")

def display():
    for i in range(size):
        print(i, ":", table[i])

while True:
    print("\n1.Insert  2.Search  3.Delete  4.Display  5.Exit")
    ch = int(input("Enter choice: "))

    if ch == 1:
        insert(int(input("Enter value: ")))
    elif ch == 2:
        search(int(input("Enter value: ")))
    elif ch == 3:
        delete(int(input("Enter value: ")))
    elif ch == 4:
        display()
    elif ch == 5:
        break
    else:
        print("Invalid choice")
