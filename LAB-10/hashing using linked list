
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

size = 7
table = [None] * size

def insert(key):
    i = key % size
    new = Node(key)
    new.next = table[i]
    table[i] = new

def search(key):
    i = key % size
    temp = table[i]
    while temp:
        if temp.data == key:
            print("Element found")
            return
        temp = temp.next
    print("Element not found")

def delete(key):
    i = key % size
    temp = table[i]
    prev = None

    while temp:
        if temp.data == key:
            if prev:
                prev.next = temp.next
            else:
                table[i] = temp.next
            print("Deleted")
            return
        prev = temp
        temp = temp.next

    print("Element not found")

def display():
    for i in range(size):
        temp = table[i]
        print(i, end=": ")
        while temp:
            print(temp.data, end=" -> ")
            temp = temp.next
        print("None")

while True:
    print("\n1.Insert 2.Delete 3.Search 4.Display 5.Exit")
    ch = int(input("Enter choice: "))

    if ch == 1:
        insert(int(input("Enter value: ")))
    elif ch == 2:
        delete(int(input("Enter value: ")))
    elif ch == 3:
        search(int(input("Enter value: ")))
    elif ch == 4:
        display()
    elif ch == 5:
        break
    else:
        print("Invalid choice")
